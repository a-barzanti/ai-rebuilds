  "categories": [
    {
      "id": "craft",
      "title": "ArtCraft Crafting Apps",
      "blurb": "A suite of desktop apps, each rebuilding a well-known creative or office tool from scratch in Rust. The authors describe them as clean-room reimplementations written predominantly by Claude Code and other AI agents."
    },
    {
      "id": "ai-software",
      "title": "Software rebuilt with AI",
      "blurb": "Frameworks, compilers, parsers and engines that were rebuilt, ported or rewritten mostly by coding agents, with the people directing them."
    },
    {
      "id": "ai-games",
      "title": "Games rebuilt with AI",
      "blurb": "Decompilations, recompilations and reconstructions of games where AI agents did much of the work. Every one needs your own copy of the game."
    },
    {
      "id": "game-engines",
      "title": "Game engine reimplementations",
      "blurb": "Long-running community engines that play classic games on modern systems. Most load the data files from a copy you own."
    },
    {
      "id": "decomp",
      "title": "Decompilations and recompilations",
      "blurb": "Human-led projects that turned console games back into buildable source code or native PC programs. They ship no game assets."
    },
    {
      "id": "clean-room",
      "title": "Clean-room classics",
      "blurb": "Famous independent reimplementations, from the BIOS that made PC clones possible to a Photoshop-compatible editor in the browser."
    },
    {
      "id": "tools",
      "title": "Tools for rebuilders",
      "blurb": "What people use to study the original and check the rebuild against it: decompilers, AI bridges, matching and diffing tools."
    }
  ],
